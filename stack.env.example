# Environment variables for docker-compose.prod.yml
# Paste these into Portainer (Stack → Environment variables → Advanced mode)
# and change every value marked CHANGE ME.

# Port on the CasaOS host (CasaOS itself uses 80, so pick a free one)
APP_PORT=8085
# The address you open the app on, e.g. http://192.168.1.50:8085 or https://rijschool.example.com
APP_URL=http://192.168.1.50:8085

# Optional. Leave empty to auto-generate once (kept in the app_storage volume).
# Generate one with: docker run --rm php:8.3-cli php -r 'echo "base64:".base64_encode(random_bytes(32)), PHP_EOL;'
APP_KEY=

DB_DATABASE=rijschool
DB_USERNAME=rijschool
DB_PASSWORD=CHANGE_ME_db_password
DB_ROOT_PASSWORD=CHANGE_ME_root_password

# true = load demo data (admin@example.com / Admin1234) on first start. Only once.
SEED_DATABASE=false

# Mail (default writes mail to the log)
MAIL_MAILER=log
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=noreply@example.com

# Only if you use a prebuilt image from a registry instead of building in Portainer
# APP_IMAGE=ghcr.io/<user>/rijschool-project:latest
