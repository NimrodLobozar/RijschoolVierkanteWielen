# Environment for the `app` container in docker-compose.yml (local use only).
# These credentials match the `mysql` service. Do not use them in production.

APP_NAME="Rijschool Vierkantewielen"
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8000
# Leave empty: a key is generated once and kept in the storage volume
APP_KEY=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=nl_NL

LOG_CHANNEL=stderr
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=rijschool
DB_USERNAME=rijschool
DB_PASSWORD=secret

SESSION_DRIVER=database
CACHE_STORE=database
QUEUE_CONNECTION=database
MAIL_MAILER=log

RUN_MIGRATIONS=true
# Seeds demo data (incl. admin@example.com / Admin1234) on first start only
SEED_DATABASE=true
